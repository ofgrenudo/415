{{/* layouts/_default/index.json */}}
{{- $index := slice -}}
{{- range where .Site.RegularPages.ByDate.Reverse "Type" "not in"  (slice "page" "json") -}}
    {{- $summary := .Content | plainify -}}
    {{- $index = $index | append (dict "title" ( .Title | plainify ) "permalink" .Permalink  "tags" ( .Params.tags ) "categories" ( .Params.categories ) "summary" $summary ) -}}
{{- end -}}
{{- $index | jsonify -}}
